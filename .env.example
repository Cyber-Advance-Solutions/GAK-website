# Browser -> API through this site's own domain (next.config.mjs forwards /api and /uploads to the backend).
# Works on localhost AND behind ngrok. For direct access use http://localhost:5000/api and http://localhost:5000.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_URL=
# Next.js server -> backend (direct)
API_INTERNAL_URL=http://localhost:5000/api
# 0 = always fresh; set e.g. 60 in production to cache pages for a minute
API_REVALIDATE_SECONDS=0

# ==============================================================================
# GAK-website — copy this file to ".env" (server) or ".env.local" (your computer)
# Read when the site starts: after a change just restart it (no rebuild needed).
# ==============================================================================

# Backend on THIS same server: put only its port (the PORT=... value in the backend's .env)  <-- CHANGE
BACKEND_PORT=5000

# Backend on ANOTHER server/domain: put its full address instead (this one wins if set)
# BACKEND_URL=https://api.example.com

# 0 = always fresh (admin changes show on the next page load). e.g. 60 = cache pages for 1 minute
API_REVALIDATE_SECONDS=0
